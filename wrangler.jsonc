{
  // Cloudflare Worker config for popwhiskey.org (Worker + static assets).
  "name": "popwhiskey",
  "main": "worker.js",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Run worker.js for every request so the /members/* gate always fires
    // (otherwise matching files would be served before the Worker sees them).
    "run_worker_first": true
  },

  // The Kavanagh Watch votes/comments and the Council's status live here.
  "kv_namespaces": [
    { "binding": "PWSOW_KV", "id": "f3d1dbabeb8542f9b53e7f6647b7135c" }
  ],

  // The admin app (gazette/app.html) is imported into worker.js as a text
  // module — Wrangler treats .html as Text by default, so no rule is needed.
  //
  // The persona guides are imported the same way, which keeps them OUT of the
  // public asset upload. `fallthrough` matters: without it this rule would
  // shadow Wrangler's built-in Text rules for .html/.txt/.sql.
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],

  // The Gazette Engine: roster, brain dumps, drafts, events, submissions.
  "d1_databases": [
    {
      "binding": "GAZETTE_DB",
      "database_name": "pwsow-gazette",
      "database_id": "0f80ede2-9b42-4590-9b68-9480212d0725"
    }
  ]
}
